{
  "name": "@hebcal/icalendar",
  "version": "7.0.6",
  "author": "Michael J. Radwin (https://github.com/mjradwin)",
  "keywords": [
    "ical",
    "icalendar",
    "jewish",
    "hebcal"
  ],
  "description": "Jewish holidays and Hebrew calendar as iCalendar RFC 2445",
  "type": "module",
  "module": "./dist/icalendar.js",
  "typings": "./dist/icalendar.d.ts",
  "exports": {
    ".": "./dist/icalendar.js"
  },
  "engines": {
    "node": ">= 20"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hebcal/hebcal-icalendar.git"
  },
  "bugs": {
    "url": "https://github.com/hebcal/hebcal-icalendar/issues"
  },
  "homepage": "https://hebcal.github.io/api/icalendar/",
  "dependencies": {
    "@hebcal/core": "^6.13.0",
    "@hebcal/hdate": "^0.23.0",
    "@hebcal/murmurhash3": "^1.0.0",
    "@hebcal/rest-api": "^7.2.1"
  },
  "scripts": {
    "build:version": "node ./version.js package.json src/pkgVersion.ts",
    "build": "npm run build:version && tsc",
    "pretest": "npm run build",
    "docs": "npx -y typedoc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint && prettier --check .",
    "clean": "rm -rf dist",
    "compile": "tsc",
    "fix": "oxlint --fix && prettier --write ."
  },
  "license": "BSD-2-Clause",
  "devDependencies": {
    "@hebcal/learning": "^6.12.0",
    "@types/node": "26.6.4",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
