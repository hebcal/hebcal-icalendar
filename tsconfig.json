{
  "compilerOptions": {
    "types": ["node"],
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "lib": ["ESNext"],
    "paths": {
      "*": ["./types/*"]
    }
  },
  "include": ["src/**/*"]
}
